# Groq API key — get free from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model selection (Groq's free fast models)
LLM_MODEL=llama-3.1-8b-instant
GRADER_MODEL=llama-3.1-8b-instant

# Embedding model (HuggingFace, downloaded locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FAISS vector store persistence directory
VECTOR_STORE_DIR=./data/faiss_index
COLLECTION_NAME=tech_docs

# Retrieval settings
TOP_K=4
MAX_RETRIES=2

# Hallucination grounding check (bonus feature, requires no extra key)
ENABLE_HALLUCINATION_CHECK=true
